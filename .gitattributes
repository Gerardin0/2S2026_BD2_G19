# BULK INSERT en el contenedor Linux parte las filas por LF: con CRLF el 
# queda pegado a la ultima columna de cada CSV (rol_id, weight_kg, medal...).
"Proyecto Fase 2/CSVs/*.csv" text eol=lf

# Los scripts de bash deben llegar a Ubuntu con LF; con CRLF bash falla con "command not found".
*.sh text eol=lf
